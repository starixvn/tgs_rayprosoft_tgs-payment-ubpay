<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<SqlQueryToolsConnectionString />
	<UserSecretsId>059a0349-6150-4891-beb3-a368d9de1fac</UserSecretsId>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)"</DockerfileBuildArguments>
	<DockerfileTag Condition="$(DockerfileTag) == ''">pgtgs/payment-ub</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tgs.Payment.UBPay\**" />
    <Content Remove="Tgs.Payment.UBPay\**" />
    <EmbeddedResource Remove="Tgs.Payment.UBPay\**" />
    <None Remove="Tgs.Payment.UBPay\**" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.2.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.8.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.5.1" />
		<PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="1.0.6" />
		<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.3.1" />
		<PackageReference Include="Tgs.MessageQueue.Compatible" Version="0.0.2" />
		<PackageReference Include="Tgs.WebApi.Toolkits" Version="0.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\UBPay.Core\UBPay.Core.csproj" />
	</ItemGroup>
	
</Project>
